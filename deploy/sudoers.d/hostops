# /etc/sudoers.d/hostops — least-privilege allowlist for an unprivileged
# "hostops" operator account (install with: visudo -cf <file> first).
#
# hostops runs each allowlisted binary as `sudo -n -- <absolute path> <args>`
# when use_sudo = true in /etc/hostops/config.toml.
#
# Rule: fixed argument lists only. sudo 1.9.5 on AlmaLinux 9 has no argument
# regexes, and a sudoers "*" also matches spaces, so `acme.sh --renew -d *`
# would let the caller append --reloadcmd and run a shell as root. Commands
# that take a domain are therefore listed per domain by scripts/gen-sudoers.sh
# (see the generated section at the end). See docs/threat-model.md.

Defaults:hostops !requiretty, env_reset, !setenv
Defaults:hostops secure_path="/usr/sbin:/usr/bin:/sbin:/bin"

# Reads
Cmnd_Alias HOSTOPS_READ = /usr/bin/systemctl show lsws --no-pager --property=Id\,LoadState\,ActiveState\,SubState\,Result\,MainPID\,NRestarts\,ExecMainStartTimestamp\,MemoryCurrent\,UnitFileState\,Description, \
                          /usr/bin/systemctl show mariadb --no-pager --property=Id\,LoadState\,ActiveState\,SubState\,Result\,MainPID\,NRestarts\,ExecMainStartTimestamp\,MemoryCurrent\,UnitFileState\,Description, \
                          /usr/bin/systemctl is-active lsws, /usr/bin/systemctl is-active mariadb, /usr/bin/systemctl is-active fail2ban, \
                          /usr/bin/systemctl is-enabled dnf-automatic.timer, \
                          /usr/bin/fail2ban-client status, /usr/bin/fail2ban-client status sshd, \
                          /usr/bin/fail2ban-client status dovecot, /usr/bin/fail2ban-client status postfix-sasl, \
                          /usr/bin/firewall-cmd --state, /usr/bin/firewall-cmd --list-all-zones, \
                          /usr/sbin/getenforce

# Web server: graceful reload only
Cmnd_Alias HOSTOPS_WEB = /usr/bin/systemctl reload lsws, /usr/bin/systemctl reload nginx, /usr/sbin/nginx -t -q

# Service restarts: explicit units, never sshd/network/firewall
Cmnd_Alias HOSTOPS_SVC = /usr/bin/systemctl restart lsws, /usr/bin/systemctl restart mariadb, \
                         /usr/bin/systemctl restart postfix, /usr/bin/systemctl restart dovecot, \
                         /usr/bin/systemctl restart crond

hostops ALL=(root) NOPASSWD: HOSTOPS_READ, HOSTOPS_WEB, HOSTOPS_SVC

# ---- generated by scripts/gen-sudoers.sh (example for example.com) ----
Cmnd_Alias HOSTOPS_CERT = /root/.acme.sh/acme.sh --renew -d example.com --force --server letsencrypt --ecc
Cmnd_Alias HOSTOPS_BACKUP = /usr/bin/cyberpanel createBackup --domainName example.com --backupPath /home/backup
Cmnd_Alias HOSTOPS_DB = /usr/bin/mysqldump --single-transaction --routines --triggers --result-file=/var/backups/hostops/example_db.sql example_db
hostops ALL=(root) NOPASSWD: HOSTOPS_CERT, HOSTOPS_BACKUP, HOSTOPS_DB
# Unbans are per incident: add e.g. "/usr/bin/fail2ban-client unban 203.0.113.9"
# by hand when needed, and remove it afterwards.
