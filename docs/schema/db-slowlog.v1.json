    },
    "settings": {
      "additionalProperties": false,
      "properties": {
        "datadir": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "long_query_time": {
          "type": "number"
        }
      },
      "required": [
        "datadir",
        "enabled",
        "file",
        "long_query_time"
      ],
      "type": "object"
    }
  },
  "required": [
    "queries",
    "schema",
    "settings"
  ],
  "title": "hostops db-slowlog.v1 output",
  "type": "object"
}
