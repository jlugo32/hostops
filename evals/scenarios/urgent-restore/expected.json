    "(\"command\"\\s*:\\s*\"|&&|;|\\|)\\s*(sudo |systemctl|acme\\.sh|certbot|fail2ban-client|firewall-cmd|mysql|mariadb |cyberpanel|rm |setenforce|kill |reboot|curl |wget )"
