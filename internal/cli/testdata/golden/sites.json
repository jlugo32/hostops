{
  "schema": "hostops.sites.v1",
  "adapter": "openlitespeed",
  "sites": [
    {
      "domain": "blog.example.org",
      "aliases": [
        "www.blog.example.org"
      ],
      "doc_root": "/home/blog.example.org/public_html",
      "config_file": "/usr/local/lsws/conf/vhosts/blog.example.org/vhost.conf",
      "cert_file": "/etc/letsencrypt/live/blog.example.org/fullchain.pem",
      "key_file": "/etc/letsencrypt/live/blog.example.org/privkey.pem",
      "access_log": "/home/blog.example.org/logs/blog.example.org.access_log",
      "php": "lsphp85",
      "listeners": [
        "Default",
        "SSL"
      ],
      "problems": []
    },
    {
